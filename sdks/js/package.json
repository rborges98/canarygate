{
  "name": "@canarygate/sdk",
  "version": "0.1.3",
  "description": "CanaryGate SDK — feature flags with real-time SSE streaming",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/client.ts src/server.ts --format esm,cjs --dts --out-dir dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "sideEffects": false,
  "license": "MIT",
  "keywords": ["feature-flags", "feature-toggles", "sse", "real-time", "rollout"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rborges98/canarygate.git",
    "directory": "sdks/js"
  },
  "homepage": "https://github.com/rborges98/canarygate/tree/main/sdks/js#readme",
  "bugs": {
    "url": "https://github.com/rborges98/canarygate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "happy-dom": "^20.11.2",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
